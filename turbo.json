{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["NEXT_TELEMETRY_DISABLED", "STORYBOOK_DISABLE_TELEMETRY"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
