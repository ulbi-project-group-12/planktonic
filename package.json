{
  "name": "@app/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "dev": "turbo run dev --env-mode=loose",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "check:pins": "node scripts/check-pins.mjs",
    "check:name": "node scripts/check-product-name.mjs",
    "lint:root": "eslint eslint.config.js scripts --max-warnings=0",
    "test:root": "node --test --test-reporter=tap scripts/check-product-name.test.mjs scripts/check-pins.test.mjs",
    "services:up": "docker compose up -d && docker compose wait s3-init",
    "services:down": "docker compose down",
    "services:reset": "docker compose down -v",
    "db:migrate": "pnpm --filter @app/api db:migrate",
    "db:migrate:dev": "pnpm --filter @app/api db:migrate:dev",
    "check:all": "pnpm format:check && pnpm check:pins && pnpm lint:root && turbo run lint typecheck test build && pnpm check:name && pnpm test:root && pnpm --filter @app/web lint:fsd && pnpm --filter @app/web build-storybook"
  },
  "prettier": "@app/config/prettier",
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored --max-warnings=0"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
