# Environment variable NAMES only. Never put a value in this file.
#
# Local development: copy this file to .env and fill in the values there.
# Every .env* file is git-ignored except this one.
# CI/CD reads GitHub secrets, never this file.
# Phase 1.1 adds DATABASE_URL, REDIS_URL and the S3 settings.

NODE_ENV=
APP_VERSION=

# Product display name and slug. The defaults live in packages/config/product.ts;
# these variables only override them.
PRODUCT_NAME=
PRODUCT_SLUG=
