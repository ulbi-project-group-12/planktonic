# Local development values. Every value is an obviously-dev default for the compose services
# on this machine (compose.yaml uses the same values as its defaults).
# Never put a real secret here.
#
# To start: cp .env.example .env   (every .env* file is git-ignored except this one)
# CI/CD reads GitHub secrets, never this file.

# Node environment for the apps; empty means each tool's default (development for `pnpm dev`).
NODE_ENV=
# Version string the apps report; empty means the built-in default (set by the release build).
APP_VERSION=

# Product display name and slug. The defaults live in packages/config/product.ts;
# these variables only override them.
# Display name override, read by the apps; empty means the default.
PRODUCT_NAME=
# Slug override (URLs, image names), read by the apps; empty means the default.
PRODUCT_SLUG=

# --- Postgres (compose) ---
# Database created on first start of the compose postgres service.
POSTGRES_DB=app
# Database owner role created on first start (compose postgres service).
POSTGRES_USER=app
# Dev-only password for POSTGRES_USER (compose postgres service).
POSTGRES_PASSWORD=app_dev_password
# Host port for Postgres, bound to 127.0.0.1 (compose); non-default to avoid clashing with 5432.
POSTGRES_PORT=55432
# Connection string for the api and Prisma; must match the four values above (127.0.0.1, not localhost).
DATABASE_URL=postgresql://app:app_dev_password@127.0.0.1:55432/app

# --- Redis (compose) ---
# Host port for Redis, bound to 127.0.0.1 (compose); non-default to avoid clashing with 6379.
REDIS_PORT=56379
# Redis connection for the api; no consumer yet (Phase 2 realtime). Must match REDIS_PORT.
REDIS_URL=redis://127.0.0.1:56379

# --- S3 / SeaweedFS (compose) ---
# Host port for the S3 gateway, bound to 127.0.0.1 (compose).
S3_PORT=58333
# S3 endpoint for the api; no consumer yet (Phase 7 files). Must match S3_PORT.
S3_ENDPOINT=http://127.0.0.1:58333
# S3 region for the api's client; SeaweedFS accepts any value. No consumer yet (Phase 7).
S3_REGION=us-east-1
# Dev bucket, created by the compose s3-init job; read by the api from Phase 7.
S3_BUCKET=app-dev
# Dev-only S3 access key: the gateway's admin identity (compose) and the api's client (Phase 7).
S3_ACCESS_KEY_ID=dev-access-key
# Dev-only S3 secret key paired with S3_ACCESS_KEY_ID (compose and, from Phase 7, the api).
S3_SECRET_ACCESS_KEY=dev-secret-key
# Path-style S3 URLs (bucket in the path), needed by SeaweedFS; read by the api from Phase 7.
S3_FORCE_PATH_STYLE=true
