# Refuse pushes to main from this machine (repository rules are not available on the free plan
# for a private repository, so this hook and the main-push-guard workflow stand in for them).
# Lead-only escape hatch for emergencies: ALLOW_PUSH_TO_MAIN=1 git push ...
# The main-push-guard workflow still flags any direct push.
if [ "${ALLOW_PUSH_TO_MAIN:-0}" = "1" ]; then
  exit 0
fi
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are not allowed."
    echo "Push your branch and open a PR instead (see CONTRIBUTING.md)."
    exit 1
  fi
done
exit 0
