# Variables of compose.prod.yml (UL-162). Runbook: docs/prod-compose.md.
#
# Local run:  cp .env.prod.example .env.prod   and pass `--env-file .env.prod` to compose.
# Server:     the filled-in copy sits next to compose.prod.yml as `.env`, mode 600.
#
# Secrets are left empty on purpose, and compose refuses to start until each one is set.
# Generate every password and key, locally too, e.g. `openssl rand -hex 24`. Passwords become
# part of a connection URL, so use URL-safe characters only (letters, digits, `-`, `_`).
# Never commit a filled-in copy: every .env* file is git-ignored except the two examples.

# --- Images ---
# Image name without the `-web` / `-api` suffix. Local builds: app. Server:
# ghcr.io/<owner>/<slug>, the names release.yml pushes.
IMAGE_PREFIX=app
# Image tag. Local builds: local. Server: the release tag to run, e.g. v0.1.0 (rollback = the
# previous tag).
APP_VERSION=local

# --- Edge (Traefik) ---
# Host name the routers answer on; requests for any other Host get 404.
APP_HOST=localhost
# Interface and port of the only published port. Server: 0.0.0.0 and 80.
HTTP_BIND=127.0.0.1
HTTP_PORT=58180
# `Secure` flag of the sticky cookie `io_srv`: false for plain HTTP (local), true behind HTTPS.
STICKY_COOKIE_SECURE=false
# Number of api replicas behind Traefik.
API_REPLICAS=2

# --- Postgres ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- S3 (SeaweedFS) ---
S3_BUCKET=app-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability (compose.prod.observability.yml only) ---
# Group id that owns /var/run/docker.sock inside the Docker host; Prometheus joins it to list
# containers. Docker Desktop: 0. Linux server: `stat -c %g /var/run/docker.sock`. Left empty so
# that compose asks for it.
DOCKER_GID=
